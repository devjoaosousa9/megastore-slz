{
  "name": "megastore-slz",
  "version": "1.0.0",
  "private": true,
  "description": "Mega Store SLZ: iPhones seminovos em São Luís, com catálogo em 3D em tempo real (Next.js + React Three Fiber + GSAP).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "cross-env STATIC_EXPORT=true NEXT_PUBLIC_BASE_PATH=/megastore-slz next build",
    "start": "next start",
    "serve:out": "node tests/e2e/serve-out.mjs 4174 /megastore-slz",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "^10.0.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
